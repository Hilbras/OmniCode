{
  "name": "omnicode-agent",
  "private": true,
  "packageManager": "pnpm@12.5.1",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "node scripts/check-no-comments.mjs && node scripts/check-kernel-layering.mjs && node scripts/check-oxlint-baseline.mjs",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:coverage": "vitest run --coverage",
    "dev:server": "pnpm --filter @omnicode/cli dev:server",
    "dev:cli": "pnpm --filter @omnicode/cli dev",
    "build:cli": "pnpm --filter @omnicode/cli build",
    "typecheck:cli": "pnpm --filter @omnicode/cli typecheck",
    "typecheck:tui": "pnpm --filter @hilbras/omnicode-tui typecheck",
    "check:workspace": "node scripts/check-workspace-globs.mjs",
    "check:architecture": "node scripts/check-kernel-layering.mjs && node scripts/check-no-comments.mjs",
    "check:agent-docs": "node scripts/check-agents-docs.mjs",
    "check:generated": "node scripts/check-generated-freshness.mjs",
    "check:tests": "node scripts/check-test-reachability.mjs",
    "check:command-paths": "node scripts/check-command-paths.mjs",
    "check:typecheck": "node scripts/check-typecheck-coverage.mjs",
    "check:package": "node scripts/check-package-hygiene.mjs",
    "check:cli-artifact": "node scripts/check-cli-artifact.mjs",
    "check:deps": "node scripts/check-deps-consistency.mjs",
    "check:audit": "node scripts/check-audit.mjs",
    "check:skills": "node --test \".agents/skills/*/*.test.cjs\"",
    "check:guards": "pnpm check:workspace && pnpm check:architecture && pnpm check:deps && pnpm check:docs-claims && pnpm check:agent-docs && pnpm docs:check && pnpm check:generated && pnpm check:tests && pnpm check:command-paths && pnpm check:typecheck && pnpm check:skills",
    "preflight": "node scripts/preflight.mjs",
    "check:docs-claims": "node scripts/check-docs-claims.mjs",
    "postinstall": "node scripts/patch-api-extractor.mjs",
    "release:version": "changeset version",
    "release": "changeset publish",
    "release:gate": "node scripts/preflight.mjs",
    "docs:build": "node scripts/build-docs.mjs",
    "docs:check": "node scripts/build-docs.mjs --check"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/cli": "^3.0.3",
    "@microsoft/api-extractor": "7.60.1",
    "@types/node": "^22.20.5",
    "eslint": "^9.18.0",
    "fontkit": "^2.0.4",
    "marked": "^18.2.1",
    "oxlint": "1.59.0",
    "oxlint-tsgolint": "^0.20.0",
    "prettier": "^3.4.0",
    "publint": "^0.3.25",
    "subset-font": "^2.9.0",
    "tsdown": "^0.22.14",
    "tsx": "^4.23.15",
    "turbo": "^2.5.0",
    "typescript": "6.0.2",
    "vitest": "^4.1.4",
    "woff2-encoder": "2.0.0"
  }
}
