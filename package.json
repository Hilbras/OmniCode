{
  "name": "omnicode-agent",
  "private": true,
  "packageManager": "pnpm@12.5.1",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "dev:server": "pnpm --filter @omnicode/cli dev:server",
    "dev:cli": "pnpm --filter @omnicode/cli dev",
    "build:cli": "pnpm --filter @omnicode/cli build",
    "typecheck:cli": "pnpm --filter @omnicode/cli typecheck",
    "typecheck:tui": "pnpm --filter @hilbras/omnicode-tui typecheck"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "eslint": "^9.18.0",
    "prettier": "^3.4.0",
    "tsdown": "^0.22.14",
    "tsx": "^4.23.15",
    "turbo": "^2.5.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.4"
  }
}
