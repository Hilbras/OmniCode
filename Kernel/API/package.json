{
  "name": "@hilbras/omnicode-api",
  "version": "0.1.0",
  "description": "The one surface consumers of the Kernel are allowed to import.",
  "license": "MIT",
  "type": "module",
  "private": true,
  "imports": {
    "#/*": "./src/*.ts"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "dependencies": {
    "@hilbras/omnicode-acp": "workspace:^",
    "@hilbras/omnicode-addons": "workspace:^",
    "@hilbras/omnicode-sdk": "workspace:^",
    "@hilbras/omnicode-tools": "workspace:^"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist"
  }
}
