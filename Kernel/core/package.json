{
  "name": "@hilbras/omnicode-core",
  "version": "0.6.0",
  "private": true,
  "description": "Re-export facade over the kernel engine and foundation, kept so existing consumers keep importing one package.",
  "license": "MIT",
  "author": "Hilbras",
  "homepage": "https://github.com/Hilbras/omnicode/tree/main/Kernel/core#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hilbras/omnicode.git",
    "directory": "Kernel/core"
  },
  "bugs": {
    "url": "https://github.com/Hilbras/omnicode/issues"
  },
  "keywords": [
    "omnicode",
    "agent",
    "ai",
    "llm",
    "session",
    "tools"
  ],
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./package.json": {
      "types": "./package.json",
      "default": "./package.json"
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@hilbras/omnicode-base": "workspace:^",
    "@hilbras/omnicode-engine": "workspace:^"
  },
  "devDependencies": {}
}
