{
  "name": "@hilbras/omnicode-addons",
  "version": "0.1.0",
  "description": "Optional agent behaviours that plug into the engine through the Feature seam.",
  "license": "MIT",
  "type": "module",
  "private": true,
  "imports": {
    "#/*": "./src/*.ts"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./*": {
      "types": "./src/*.ts",
      "default": "./src/*.ts"
    }
  },
  "dependencies": {
    "@hilbras/omnicode-core": "workspace:^",
    "pathe": "^2.0.3",
    "xstate": "^5.32.5"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist"
  }
}
