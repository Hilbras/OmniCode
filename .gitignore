# build
.zcode/
dist/
# Intermediate from `VIS_SINGLEFILE=1 vite build` inside the vis web app. The CLI's
# `prebuild` (apps/omnicode-cli/scripts/build-vis-asset.mjs) regenerates it on every
# build and reads it immediately, so the checked-in copy added nothing but drift:
# the blob at HEAD no longer matched the generated module it had produced. The
# artifact that matters, apps/omnicode-cli/src/generated/vis-web-asset.ts, stays
# tracked and is gated by `pnpm check:generated` (gen:vis-asset).
dist-single/
.next/
out/
.turbo/

# logs
*.log
npm-debug.log*

# OS
.DS_Store

# scratch
.tmp/

# generated static docs site (scripts/build-docs.mjs)
docs-site/

# runtime artifacts (API test/daemon event logs) and personal tooling config
packages/API/reports/latest/events-*.jsonl
apps/omnicode-mobile/.claude/
