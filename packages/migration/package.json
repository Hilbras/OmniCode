{
  "name": "@hilbras/omnicode-migration",
  "version": "0.1.18",
  "description": "Migrate omnicode-cli (~/.omnicode/) data into omnicode (~/.omnicode/).",
  "license": "MIT",
  "type": "module",
  "private": true,
  "files": [
    "dist"
  ],
  "imports": {
    "#/*": "./src/*.ts"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@hilbras/omnicode-base": "workspace:^",
    "@hilbras/omnicode-core": "workspace:^",
    "@hilbras/omnicode-engine": "workspace:^",
    "smol-toml": "^1.6.1",
    "tar": "^7.5.22",
    "yauzl": "^3.3.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@hilbras/omnicode-transcript": "workspace:^",
    "@types/yauzl": "^2.10.3",
    "@types/yazl": "^2.4.6",
    "yazl": "^3.3.1"
  }
}
