{
  "name": "@hilbras/omnicode-channels",
  "version": "0.1.0",
  "description": "Channel platform contracts, adapters, session binding, and lifecycle commands for OmniCode.",
  "license": "MIT",
  "author": "Hilbras",
  "type": "module",
  "private": true,
  "imports": {
    "#/*": "./src/*.ts"
