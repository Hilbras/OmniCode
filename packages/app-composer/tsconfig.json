{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    // Match the consumers: both apps compile package source with
    // noPropertyAccessFromIndexSignature off (same rationale as app-core).
    "noPropertyAccessFromIndexSignature": false
  },
  // The sibling declaration files are listed because this package's program
  // compiles the `app-*` sources it imports, and those rely on declarations that
  // live beside them rather than in an ambient package.
  "include": [
    "src",
    "../vite-preset/src/icons.d.ts",
    "../vite-preset/src/worker.d.ts",
    "../app-core/src/env.d.ts"
  ]
}
