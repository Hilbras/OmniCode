{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "emitDeclarationOnly": true,
    "declaration": true,
    "declarationMap": false,
    "sourceMap": false,
    "outDir": ".tmp-api-extractor/dts",
    "rootDir": ".."
  },
  "include": [
    "src/**/*.ts",
    "../../packages/base/src/**/*.ts",
    "../../packages/core/src/**/*.ts",
    "../../packages/engine/src/**/*.ts",
    "../../packages/memory/src/**/*.ts",
    "../../packages/Kaos/src/**/*.ts",
    "../llm/src/**/*.ts",
    "../auth/src/**/*.ts"
  ],
  "exclude": [
    "dist",
    ".tmp-api-extractor",
    "examples",
    "test",
    "../../packages/*/dist",
    "../../packages/*/test",
    "../../packages/core/src/human/test",
    "../../packages/engine/src/human/test",
    "../../packages/engine/test",
    "../../packages/engine/src/**/test/**"
  ]
}
