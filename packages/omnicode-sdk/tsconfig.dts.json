{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "emitDeclarationOnly": true,
    "declaration": true,
    "declarationMap": false,
    "sourceMap": false,
    "outDir": ".tmp-api-extractor/dts",
    "rootDir": ".."
  },
  "include": [
    "src/**/*.ts",
    "../omnicode-core/src/**/*.ts",
    "../omnicode-core/src/env.d.ts",
    "../omnicode-kaos/src/**/*.ts",
    "../omnicode-client/src/**/*.ts",
    "../omnicode-llm/src/**/*.ts",
    "../omnicode-auth/src/**/*.ts"
  ],
  "exclude": ["dist", ".tmp-api-extractor", "examples", "test", "../*/dist", "../*/test", "../omnicode-core/src/human/test"]
}