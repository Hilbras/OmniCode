{
  "name": "@omnicode/cli-ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./theme/colors": {
      "types": "./src/theme/colors.ts",
      "default": "./src/theme/colors.ts"
    },
    "./theme/theme": {
      "types": "./src/theme/theme.ts",
      "default": "./src/theme/theme.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "echo \"no tests yet\""
  },
  "dependencies": {
    "chalk": "^5.4.1"
  }
}
